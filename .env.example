# Copy to .env and fill in real values. .env is gitignored - never commit real credentials.

# Used by fetch_telemetry.py and quality_gate.py (as the regression baseline lookup).
TELEMETRY_SERVER_URL=https://your-backend.onrender.com
TELEMETRY_API_KEY=same-value-as-the-backend-and-apps-API_KEY

# Used by publish_model.py only. Must be a DIFFERENT secret from TELEMETRY_API_KEY - that one
# ships inside the Android APK and can be extracted, so it must never be able to publish a model.
PUBLISH_KEY=ci-only-secret-set-in-backend-env-and-github-actions-secrets
